# Copie este archivo como .env y coloque su clave para activar el análisis con IA.
# Sin clave, el reporte PDF se genera igual con un análisis basado en reglas.
DEEPSEEK_API_KEY=sk-...
# Opcional: modelo de DeepSeek a usar (por defecto deepseek-chat)
# DATASTREAM_MODELO_IA=deepseek-chat
# Opcional: URL base de la API compatible con OpenAI (por defecto https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
